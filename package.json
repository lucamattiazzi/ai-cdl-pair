{
  "name": "ai-cdl-pair",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm bridge:build && pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check apps/*/src apps/*/package.json apps/*/tsconfig.json apps/*/*.ts packages/*/src packages/*/package.json packages/*/tsconfig.json skills/* scripts .github *.json *.ts",
    "test": "node --test scripts/isolation.test.mjs && vitest run --coverage",
    "test:unit": "vitest run",
    "test:isolation": "node --test scripts/isolation.test.mjs",
    "pair:test": "vitest run packages/addin-core packages/pair packages/pair-cli packages/protocol packages/transport packages/excel apps/pair-addin apps/pair-server",
    "pair:addin:dev": "pnpm --filter @ai-cdl/pair-addin dev",
    "pair:server:dev": "pnpm bridge:build && pnpm --filter @ai-cdl/pair-server dev",
    "pair:build": "pnpm bridge:build && pnpm --filter @ai-cdl/pair-addin... --filter @ai-cdl/pair-server... build",
    "manifest:generate": "pnpm --filter @ai-cdl/pair-addin manifest:development",
    "manifest:production": "pnpm --filter @ai-cdl/pair-addin manifest:production",
    "manifest:check": "pnpm --filter @ai-cdl/pair-addin manifest:check",
    "smoke:packages": "node scripts/package-smoke.mjs",
    "smoke:consumer": "node scripts/external-consumer-smoke.mjs",
    "changeset": "changeset",
    "bridge:build": "node scripts/build-bridge.mjs",
    "harness:install": "node scripts/install-harness.mjs",
    "test:harness": "node --test scripts/install-harness.test.mjs",
    "test:browser": "node --test scripts/pair-browser.test.mjs",
    "agent": "node packages/pair-cli/dist/agent.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/office-js": "1.0.547",
    "@vitest/coverage-v8": "4.1.11",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0"
}
