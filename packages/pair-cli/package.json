{
  "name": "@ai-cdl/pair-cli",
  "version": "0.1.1",
  "description": "Encrypted Excel bridge, native coding-harness adapters, MCP tools and local trace subscriptions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ai-cdl-pair": "./dist/cli.js",
    "ai-cdl-pair-agent": "./dist/agent.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-cdl/protocol": "workspace:^",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.21.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
