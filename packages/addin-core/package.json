{
  "name": "@ai-cdl/addin-core",
  "version": "0.1.1",
  "description": "Host-agnostic Excel add-in runtime for AI-CDL",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --external @ai-cdl/protocol --external @ai-cdl/excel",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-cdl/excel": "workspace:^",
    "@ai-cdl/protocol": "workspace:^"
  }
}
