{
  "name": "@ai-cdl/transport",
  "version": "0.2.0-beta.0",
  "description": "Transport lifecycle and message delivery for AI-CDL",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --external @ai-cdl/protocol",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-cdl/protocol": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucamattiazzi/ai-cdl-pair.git",
    "directory": "packages/transport"
  },
  "homepage": "https://github.com/lucamattiazzi/ai-cdl-pair#readme",
  "bugs": {
    "url": "https://github.com/lucamattiazzi/ai-cdl-pair/issues"
  }
}
